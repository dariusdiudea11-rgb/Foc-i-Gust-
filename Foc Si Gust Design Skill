/* ============================================================
   FOC ȘI GUST TRADIȚIONAL — Design Tokens
   Diudea Grup S.R.L. · Romanian traditional food
   Colors sampled from the brand logo. Type mirrors the
   wordmark (slab serif) + subtitle (clean geometric sans).
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=Hanken+Grotesk:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap');

:root {
  /* ---- Brand core (straight from the logo) ---- */
  --ink:            #2E2A24;  /* charcoal wordmark + medallion */
  --paprika:        #8E1F1B;  /* "Tradițional" deep red — PRIMARY */
  --paprika-deep:   #6F1714;  /* pressed / hover-dark */
  --flame:          #C2611E;  /* flame orange — SECONDARY */
  --flame-bright:   #D56E34;  /* brightest flame highlight */
  --ember:          #9E2B12;  /* red-orange transition in flame */

  /* ---- Appetizing extensions (folk palette, complementary) ---- */
  --honey:          #D69A2D;  /* mustard / honey gold */
  --honey-soft:     #E8C879;  /* light gold tint */
  --herb:           #5B7A45;  /* fresh green */
  --herb-deep:      #3E5A30;

  /* ---- Warm neutrals ---- */
  --parchment:      #F5EFE3;  /* page background */
  --parchment-2:    #EFE7D7;  /* alt section background */
  --surface:        #FDFBF6;  /* cards / raised surfaces */
  --cream-line:     #E5DAC6;  /* hairline borders */
  --cream-line-2:   #D8CAB2;  /* stronger border */

  /* ---- Text on light ---- */
  --fg-1:           #2E2A24;  /* primary text */
  --fg-2:           #6E6357;  /* secondary text */
  --fg-3:           #9A8E7D;  /* muted / captions */
  --fg-on-dark:     #F5EFE3;  /* text on ink/paprika */
  --fg-on-dark-2:   #C9BCA8;  /* secondary on dark */

  /* ---- Semantic ---- */
  --success:        #5B7A45;
  --warning:        #D69A2D;
  --danger:         #8E1F1B;
  --link:           #8E1F1B;

  /* ---- Type families ---- */
  --font-display:   'Bitter', Georgia, 'Times New Roman', serif;
  --font-sans:      'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;

  /* ---- Type scale (1.250 major-third, 16px base) ---- */
  --text-xs:    0.75rem;   /* 12 */
  --text-sm:    0.875rem;  /* 14 */
  --text-base:  1rem;      /* 16 */
  --text-md:    1.25rem;   /* 20 */
  --text-lg:    1.563rem;  /* 25 */
  --text-xl:    1.953rem;  /* 31 */
  --text-2xl:   2.441rem;  /* 39 */
  --text-3xl:   3.052rem;  /* 49 */
  --text-4xl:   3.815rem;  /* 61 */
  --text-5xl:   4.768rem;  /* 76 */

  --leading-tight:   1.08;
  --leading-snug:    1.25;
  --leading-normal:  1.55;
  --leading-relaxed: 1.7;

  --tracking-tight:  -0.02em;
  --tracking-normal: 0;
  --tracking-wide:   0.04em;
  --tracking-caps:   0.14em;  /* eyebrows / labels */

  /* ---- Spacing (4px base) ---- */
  --space-1: 4px;   --space-2: 8px;   --space-3: 12px;  --space-4: 16px;
  --space-5: 24px;  --space-6: 32px;  --space-7: 48px;  --space-8: 64px;
  --space-9: 96px;  --space-10: 128px;

  /* ---- Radii ---- */
  --radius-sm:  6px;
  --radius-md:  10px;
  --radius-lg:  16px;
  --radius-xl:  24px;
  --radius-pill: 999px;

  /* ---- Warm-tinted shadows ---- */
  --shadow-xs: 0 1px 2px rgba(46,42,36,0.06);
  --shadow-sm: 0 2px 6px rgba(46,42,36,0.08);
  --shadow-md: 0 8px 20px -6px rgba(46,42,36,0.14);
  --shadow-lg: 0 18px 40px -12px rgba(46,42,36,0.22);
  --shadow-ember: 0 10px 30px -8px rgba(142,31,27,0.30);

  /* ---- Motion (moderate, classy) ---- */
  --ease-out:   cubic-bezier(0.22, 1, 0.36, 1);
  --ease-soft:  cubic-bezier(0.4, 0, 0.2, 1);
  --dur-fast:   160ms;
  --dur-base:   260ms;
  --dur-slow:   480ms;
}

/* ============================================================
   SEMANTIC ELEMENT STYLES
   ============================================================ */

.fg-display { font-family: var(--font-display); }
.fg-sans    { font-family: var(--font-sans); }

/* Eyebrow / kicker label */
.fg-eyebrow {
  font-family: var(--font-sans);
  font-weight: 700;
  font-size: var(--text-sm);
  letter-spacing: var(--tracking-caps);
  text-transform: uppercase;
  color: var(--paprika);
}

/* Display headline */
.fg-h1 {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(2.4rem, 5vw, var(--text-5xl));
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-tight);
  color: var(--fg-1);
}
.fg-h2 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(2rem, 4vw, var(--text-3xl));
  line-height: var(--leading-tight);
  letter-spacing: var(--tracking-tight);
  color: var(--fg-1);
}
.fg-h3 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: var(--text-xl);
  line-height: var(--leading-snug);
  color: var(--fg-1);
}
.fg-h4 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: var(--text-md);
  line-height: var(--leading-snug);
  color: var(--fg-1);
}

/* Lead paragraph */
.fg-lead {
  font-family: var(--font-sans);
  font-weight: 400;
  font-size: var(--text-md);
  line-height: var(--leading-relaxed);
  color: var(--fg-2);
}
/* Body */
.fg-body {
  font-family: var(--font-sans);
  font-weight: 400;
  font-size: var(--text-base);
  line-height: var(--leading-normal);
  color: var(--fg-1);
}
.fg-small {
  font-family: var(--font-sans);
  font-weight: 400;
  font-size: var(--text-sm);
  line-height: var(--leading-normal);
  color: var(--fg-2);
}
.fg-caption {
  font-family: var(--font-sans);
  font-weight: 500;
  font-size: var(--text-xs);
  letter-spacing: var(--tracking-wide);
  color: var(--fg-3);
}
